@article{wang2022covid,
  abbr        = {Acta Geogr Sin},
  bibtex_show = {false},
  title       = {Spatial and temporal patterns and factors influencing the spread of the COVID-19 pandemic in China},
  author      = {Wang, B. and Liu, T. and Li, L. and Li, Q. and Jia, P. and Chen, J.},
  journal     = {Acta Geographica Sinica},
  volume      = {77},
  number      = {2},
  pages       = {443--456},
  year        = {2022},
  html        = {https://doi.org/10.11821/dlxb202202013},
  abstract    = {This study analyses the spatial and temporal evolution of COVID-19 across China from January to March 2020 at the prefecture-city level. Using spatial autocorrelation and panel regression, we find that inter-city population movement, particularly from Wuhan, was the dominant driver of early diffusion, while local transmission intensity was shaped by population density, temperature, and public health response capacity.},
  note        = {In Chinese},
  dimensions  = {true}
}
 
@article{chen2022wheat,
  abbr        = {J Nat Resour},
  bibtex_show = {false},
  title       = {Association between high-yield and stable-yield in major northern winter wheat production regions of China and its influencing factors},
  author      = {Chen, Xiaolin and Tan, Xiaoyue and Li, Luning and Chen, Jin and Li, Qiang},
  journal     = {Journal of Natural Resources},
  volume      = {37},
  number      = {1},
  pages       = {263--276},
  year        = {2022},
  html        = {https://doi.org/10.31497/zrzyxb.20220118},
  abstract    = {This paper examines the spatial relationship between high-yield and stable-yield patterns in the major winter wheat production regions of northern China. Using county-level yield data spanning multiple decades, we apply spatial statistical methods to identify clusters of co-occurring high-yield and stable-yield counties, and analyse the roles of climate variability, irrigation infrastructure, and agricultural management practices as influencing factors.},
  note        = {In Chinese},
  dimensions  = {true}
}
 
@article{li2021wifi,
  abbr        = {Prog Geogr},
  bibtex_show = {false},
  title       = {A new support of human activity research: Characteristics, research status, and application prospects of Wi-Fi data},
  author      = {Li, Luning and Liu, Menghang and Li, Qiang and Hu, Cheng and Chen, Jin},
  journal     = {Progress in Geography},
  volume      = {40},
  number      = {11},
  pages       = {1970--1982},
  year        = {2021},
  html        = {https://doi.org/10.18306/dlkxjz.2021.11.014},
  abstract    = {Wi-Fi probe data, collected passively from the wireless signals emitted by mobile devices, offer fine-grained, large-scale records of human movement in public spaces. This review systematically summarises the data characteristics of Wi-Fi probes, surveys current research on data collection, preprocessing, and analytical applications in human mobility and tourism studies, and identifies key challenges and future directions for this emerging data source.},
  note        = {In Chinese},
  dimensions  = {true}
}
 
@article{li2018germany,
  abbr        = {J Subtrop Resour Environ},
  bibtex_show = {false},
  title       = {The Experience and Enlightenments of National Land Spatial Development in Germany},
  author      = {Li, Luning and Kong, Fanhao and Dai, Teqi and Huang, Daquan},
  journal     = {Journal of Subtropical Resources and Environment},
  volume      = {13},
  number      = {2},
  pages       = {79--84},
  year        = {2018},
  html        = {https://doi.org/10.19687/j.cnki.1673-7105.2018.02.0011},
  abstract    = {Germany's national land spatial planning system is internationally recognised for its hierarchical structure, coordinated governance, and strict ecological protection principles. This paper reviews Germany's experience in spatial development planning across federal, state, and regional scales, and draws lessons for China's ongoing reform of its territorial spatial planning framework, with particular attention to multi-level coordination mechanisms and ecological redline management.},
  note        = {In Chinese},
  dimensions  = {true}
}
 
@article{zhang2015pollution,
  abbr        = {Urban Environ},
  bibtex_show = {false},
  title       = {Analysis of Pollution Load in the North of Haihe Basin in Tianjin},
  author      = {Zhang, Xiaohui and Yang, Yanan and Li, Luning and Zhao, Jian and Wang, Juan},
  journal     = {Urban Environment \& Urban Ecology},
  volume      = {28},
  number      = {2},
  pages       = {20--24},
  year        = {2015},
  abstract    = {Taking the northern sub-basin of the Haihe River system in Tianjin as the study area, this paper calculates the pollution loads of major pollutants—including chemical oxygen demand, total nitrogen, and total phosphorus—from point and non-point sources. The spatial distribution of pollution load is mapped and the dominant pollution sources are identified, providing a scientific basis for targeted water environment management in the region.},
  note        = {In Chinese},
  dimensions  = {true}
}
 
