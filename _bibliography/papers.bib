  abstract    = {We propose IDWPSB, an inverse distance weighting method that adjusts distance decay according to visitors' path selection behaviour. In a case study of the Shichahai scenic area in Beijing, it reduced absolute deviation by 17.62 percent compared with traditional IDW.},
  dimensions  = {true}
}
 
